# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd


# Build / packaging
build/
dist/
*.egg-info/


# Virtual environments
.venv/
venv/
env/


# Jupyter Notebook checkpoints
.ipynb_checkpoints/


# Data (local / large files)
data/raw/**/*
!data/raw/.gitkeep

data/processed/**/*
!data/processed/.gitkeep

data/external/**/*
!data/external/.gitkeep

# Model artifacts 
models/metrics/**/*
!models/metrics/.gitkeep

models/trained/**/*
!models/trained/.gitkeep

*.joblib
*.pkl
*.h5


# Reports & outputs
reports/figures/**/*
!reports/figures/.gitkeep

reports/metrics/**/*
!reports/metrics/.gitkeep

outputs/**/*
!outputs/.gitkeep

mlruns/


# Logs
*.log


# OS files
.DS_Store
Thumbs.db


# Environment variables / secrets
.env
kaggle.json
.kaggle/


# IDEs
.vscode/
.idea/


# Testing / coverage
.pytest_cache/
.coverage
htmlcov/